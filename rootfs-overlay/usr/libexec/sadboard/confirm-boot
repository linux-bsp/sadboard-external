#!/bin/sh
set -eu
if ! grep -qw 'sadboard.netboot=1' /proc/cmdline; then
    exec /usr/libexec/device-manager/fw-confirm
fi
# Debug network boots must not mark SD deployments good or run OTA maintenance.
# Keep the normal observation window and log seal for manual panic exercises.
read -r format version build extra < /etc/sadboard/build.conf
[ "$format" = SBNET1 ] && [ -z "${extra:-}" ] && [ "${#build}" = 64 ]
count=0
while [ "$count" -lt 6 ]; do
    sleep 5
    [ "$(cat /run/device-manager/storage-state)" = persistent ]
    for unit in systemd-networkd.service sadboard-debug.service dropbear.service logctld.service; do
        systemctl is-active --quiet "$unit"
    done
    count=$((count + 1))
done
mkdir -p /data/sadboard
printf '%s\n' "$build" > /data/sadboard/netboot-confirmed.new
mv /data/sadboard/netboot-confirmed.new /data/sadboard/netboot-confirmed
printf '%s\n' netboot > /run/fwctl-boot-confirmed
logctl boot-event health-confirmed
echo "[sadboard] [INFO] Network debug boot ready; reference build=$(printf '%.8s' "$build"); SD A/B metadata unchanged"
