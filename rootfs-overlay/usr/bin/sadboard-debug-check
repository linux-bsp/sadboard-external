#!/bin/sh
# Read-only capability checks; no stress, tracing session or crash is triggered.
fail=0
tool_available() (
    # The BSP's minimal ash omits the command builtin.
    IFS=:
    set -f
    for directory in $PATH; do
        [ -x "${directory:-.}/$1" ] && [ ! -d "${directory:-.}/$1" ] && exit 0
    done
    exit 1
)
printf 'Kernel: '; uname -a
for tool in sadboard gdbserver strace ltrace valgrind perf trace-cmd ps vmstat iostat iperf3 tcpdump ss stress-ng curl; do
    if tool_available "$tool"; then
        printf 'OK tool %s\n' "$tool"
    else
        printf 'MISSING tool %s\n' "$tool"; fail=1
    fi
done
for path in /proc/config.gz /proc/sys/kernel/core_pattern /proc/pressure/memory /sys/kernel/tracing/available_tracers /sys/kernel/tracing/events/sched/sched_switch/enable; do
    if [ -r "$path" ]; then
        printf 'OK interface %s\n' "$path"
    else
        printf 'MISSING interface %s\n' "$path"; fail=1
    fi
done
printf 'Core policy: '; cat /proc/sys/kernel/core_pattern
if [ -d /run/systemd/system ] && systemctl is-active --quiet sadboard-debug.service; then
    echo 'OK service sadboard-debug.service'
else
    echo 'MISSING service sadboard-debug.service'; fail=1
fi
exit "$fail"
