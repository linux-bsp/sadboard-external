#!/bin/sh
# All fault injection stays inside two owned network namespaces.
set -eu
[ "$#" = 2 ] || exit 64
mode=$1; run=$2
case "$mode" in bug|verify) ;; *) exit 64 ;; esac
left=sb-left-${run##*/}; right=sb-right-${run##*/}
lv=sbL$$; rv=sbR$$
owned_left=0; owned_right=0; link_created=0; capture=; server=; client=
cleanup() {
    for pid in "$capture" "$server" "$client"; do
        if [ -n "$pid" ]; then kill -TERM "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi
    done
    if [ "$link_created" = 1 ]; then ip link del "$lv" 2>/dev/null || true; fi
    failure=0
    if [ "$owned_left" = 1 ]; then ip netns del "$left" || failure=70; fi
    if [ "$owned_right" = 1 ]; then ip netns del "$right" || failure=70; fi
    return "$failure"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
ip netns add "$left"; owned_left=1
ip netns add "$right"; owned_right=1
ip link add "$lv" type veth peer name "$rv"
link_created=1
ip link set "$lv" netns "$left"
ip link set "$rv" netns "$right"
ip -n "$left" addr add 198.18.0.1/30 dev "$lv"
ip -n "$right" addr add 198.18.0.2/30 dev "$rv"
ip -n "$left" link set lo up; ip -n "$right" link set lo up
ip -n "$left" link set "$lv" up; ip -n "$right" link set "$rv" up
printf 'left=%s\nright=%s\nleft_interface=%s\nright_interface=%s\n' "$left" "$right" "$lv" "$rv" > "$run/network.info"
echo "[sadboard] [INFO] Isolated network: $left/$lv -> $right/$rv (198.18.0.0/30)"
ip netns exec "$left" tcpdump -U -n -i "$lv" -w "$run/network.pcap" > "$run/tcpdump.log" 2>&1 &
capture=$!
sleep 0.1
kill -0 "$capture"
ping_test() {
    ip netns exec "$left" ping -c 5 -i 0.2 -W 1 198.18.0.2 > "$run/$1.ping"
    cat "$run/$1.ping"
}
throughput() {
    label=$1
    ip netns exec "$right" iperf3 -s -1 -p 5207 > "$run/$label.server" 2>&1 &
    server=$!
    sleep 0.1
    ip netns exec "$left" iperf3 -c 198.18.0.2 -p 5207 -n 1M -J > "$run/$label.iperf.json" &
    client=$!
    sleep 0.1
    ip netns exec "$left" ss -ti > "$run/$label.sockets"
    wait "$client"; client=
    wait "$server"; server=
}
if [ "$mode" = verify ]; then ping_test baseline; throughput baseline; fi
ip netns exec "$left" tc qdisc add dev "$lv" root netem delay 100ms
ping_test delayed
throughput delayed
ip netns exec "$left" tc -s qdisc show dev "$lv" > "$run/delayed.qdisc"
if [ "$mode" = verify ]; then
    ip netns exec "$left" tc qdisc replace dev "$lv" root netem loss 100%
    result=0
    ip netns exec "$left" ping -c 3 -i 0.2 -W 1 198.18.0.2 > "$run/lost.ping" || result=$?
    [ "$result" = 1 ] || exit 70
    grep -q '100% packet loss' "$run/lost.ping"
    ip netns exec "$left" tc -s qdisc show dev "$lv" > "$run/lost.qdisc"
    ip netns exec "$left" tc qdisc del dev "$lv" root
    ping_test restored
    echo '[sadboard] [INFO] Reference network repair passed: delay/loss removed; inspect RTT, qdisc, TCP results and packet capture'
else
    echo '[sadboard] [INFO] Inspect the namespace for eight seconds; tc never modifies the host eth0'
    sleep 8
fi
kill -TERM "$capture"
wait "$capture"; capture=
[ -s "$run/network.pcap" ]
