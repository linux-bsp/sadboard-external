CASE(fd_exec, "fd-cloexec", "B-FD03", "Exec inherits pipe writer / missing EOF", fd, 1)
CASE(fd_close, "fd-closewait", "B-FD04", "Peer FIN without local close", fd, 2)
CASE(fd_epoll, "fd-epoll", "B-FD05", "Epoll DEL does not close the descriptor", fd, 3)
CASE(mm_limit, "memory-enomem", "B-MM02", "Address space limit / ENOMEM without OOM", mem, 0)
CASE(mm_rss, "memory-residency", "B-MM03", "Virtual mapping vs resident pages", mem, 1)
CASE(mm_shmem, "memory-shmem", "B-MM04", "Unlinked shmem retains open/mapped references", mem, 2)
CASE(mm_kill, "memory-sigkill", "B-MM05", "External SIGKILL vs OOM", mem, 3)
CASE(cpu_eagain, "cpu-eagain", "B-CPU02", "Nonblocking EAGAIN busy loop", cpu, 0)
CASE(cpu_log, "cpu-logging", "B-CPU03", "Repeated formatting and log writes", cpu, 1)
CASE(cpu_poll, "cpu-epollout", "B-CPU04", "Always-ready EPOLLOUT busy loop", cpu, 2)
CASE(cpu_cache, "cpu-locality", "B-CPU05", "Strided vs sequential cache access", cpu, 3)
CASE(sy_dead, "sync-abba", "B-SYNC02", "Deterministic ABBA deadlock", sync, 0)
CASE(sy_lost, "sync-condvar", "B-SYNC03", "Condition signal without predicate protocol", sync, 1)
CASE(sy_race, "sync-update", "B-SYNC04", "Individually locked accesses lose updates", sync, 2)
CASE(sy_join, "sync-shutdown", "B-SYNC05", "Joining a blocked receiver without waking it", sync, 3)
CASE(net_frame, "net-framing", "B-NET02", "TCP has no application message boundaries", net, 0)
