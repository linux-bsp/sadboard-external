/* Complete teaching cases, separate from the original basic/advanced catalog. */
CASE(asm_width, "asm-width", "L-ASM01", "A64 access width reads an adjacent field", assembly, 0)
CASE(asm_sign, "asm-sign", "L-ASM02", "A64 zero extension changes a signed byte", assembly, 1)
CASE(asm_pointer, "asm-pointer", "L-ASM03", "A64 W-register write truncates a pointer (no invalid access)", assembly, 2)
CASE(asm_branch, "asm-branch", "L-ASM04", "A64 signed condition accepts an unsigned oversized length", assembly, 3)
CASE(asm_call, "asm-call", "L-ASM05", "A64 caller relies on a volatile register across BL", assembly, 4)
CASE(asm_layout, "asm-layout", "L-ASM06", "A64 structure offset ignores ABI padding", assembly, 5)
CASE(asm_bounds, "asm-bounds", "L-ASM07", "A64 loop reads a logical sentinel beyond count", assembly, 6)
CASE(asm_preserve, "asm-preserve", "L-ASM08", "A64 callee violates X19 preservation inside a guarded probe", assembly, 7)
CASE(k_cow, "kernel-cow", "K-MM01", "Fork COW is mistaken for a shared result channel", kernel, 0)
CASE(k_rename, "kernel-rename", "K-VFS01", "Atomic rename does not retarget an already-open file", kernel, 1)
CASE(k_eventfd, "kernel-eventfd", "K-IPC01", "Eventfd counter aggregation is mistaken for one request", kernel, 2)
CASE(k_timerfd, "kernel-timerfd", "K-TIME01", "Timerfd expiration count is mistaken for one tick", kernel, 3)
CASE(k_zombie, "kernel-zombie", "K-PROC01", "Exited child remains a zombie until wait reaps it", kernel, 4)
CASE(k_datagram, "kernel-udp-trunc", "K-NET01", "A short UDP buffer silently loses the datagram tail", kernel, 5)
CASE(k_pipe, "kernel-pipe", "K-IO01", "A successful pipe read returns a partial application frame", kernel, 6)
CASE(k_affinity, "kernel-affinity", "K-SCHED01", "CPU selection ignores the process allowed affinity mask", kernel, 7)
