#!/bin/sh
set -eu
tools=${SADBOARD_LIBEXEC:-/usr/libexec/sadboard}
new_run() {
    . "${0%/*}/results.sh"
    root=$(sadboard_results_root)
    sadboard_results_prepare "$root"
    run=${SADBOARD_RUN:-$(mktemp -d "$root/$1-XXXXXXXX")}
    case "$(sadboard_results_filesystem "$(cd "$run" && pwd -P)")" in
        nfs|nfs4) umask 022; chmod go+rx "$run" ;;
    esac
    echo "[sadboard] [INFO] Scenario=$1 results=$run"
}
usage() {
    echo 'Usage: sadboard {list [ID_PREFIX]|run CASE|verify CASE}; CASE=crash|oom|cpu|lock|fd|network|panic|deadline|backlog|tcp' >&2
    exit 64
}
advanced() {
    operation=$1; scenario=$2; shift 2
    new_run "$scenario-$operation"
    if [ "$scenario" = tcp ]; then
        mode=bug; [ "$operation" != verify ] || mode=verify
        "$tools/run-tcp" "$mode" "$1" "$run"
    else
        for mode in bug fixed; do
            [ "$mode:$operation" != fixed:run ] || break
            timeout -s KILL 15 "$tools/$scenario-$mode" "$@" "$run/$scenario-$mode.csv" > "$run/$scenario-$mode.out"
        done
    fi
    cat "$run/$scenario-bug.out"
    if [ "$operation" = verify ]; then
        cat "$run/$scenario-fixed.out"
        "$tools/check-result" "$scenario" verify "$run" 0 "$@"
    fi
}
case "${1:-}" in
    list)
        [ "$#" -le 2 ] || usage
        shift
        exec "$tools/case-suite" --catalog "$@"
        ;;
    run)
        [ "$#" -ge 2 ] || usage
        case "$2" in
            crash)
                new_run crash
                cd "$run"
                # BusyBox ash uses 512-byte blocks for RLIMIT_CORE: 32 MiB.
                ulimit -c 65536
                result=0
                "$tools/crash-bug" "${3:-42}" > "$run/crash-bug.out" || result=$?
                cat "$run/crash-bug.out"
                exit "$result" ;;
            oom) new_run oom; exec "$tools/run-memory" bug "$run" ;;
            cpu) new_run cpu; timeout -s KILL 30 "$tools/cpu-bug" "${3:-4096}" "${4:-500000}" "${5:-42}" > "$run/cpu-bug.out"; cat "$run/cpu-bug.out" ;;
            lock) new_run lock; timeout -s KILL 20 "$tools/lock-bug" "${3:-20}" "${4:-50000}" > "$run/lock-bug.out"; cat "$run/lock-bug.out" ;;
            fd)
                new_run fd
                result=0
                "$tools/fd-bug" "${3:-128}" "${4:-20}" > "$run/fd-bug.out" || result=$?
                echo "$result" > "$run/fd-bug.exit"
                cat "$run/fd-bug.out"
                exit "$result" ;;
            network) new_run network; exec "$tools/run-network" bug "$run" ;;
            kernel-oops|kernel-lockup|watchdog-probe) new_run "$2"; exec "$tools/watchdog-probe" --lock sh "$tools/run-kernel" "$2" "$run" ;;
            memory-cma) new_run memory-cma; exec "$tools/watchdog-probe" --lock sh "$tools/run-cma" run "$run" ;;
            irq-ownership|irq-wake|irq-shared|irq-defer|irq-drain|sync-transaction|sync-trylock|sync-assert|rcu-readside|rcu-srcu|rcu-callback)
                new_run "$2-run"
                "$tools/watchdog-probe" --lock sh "$tools/run-study" run "$2" "$run"
                cat "$run/study-bug.out" ;;
            async-coalesce|async-ordered|async-predicate|async-reference|async-stop)
                new_run "$2-run"
                "$tools/watchdog-probe" --lock sh "$tools/run-async" run "$2" "$run"
                cat "$run/async-bug.out" ;;
            driver-match|driver-property|driver-defer|driver-unwind|driver-remove)
                new_run "$2-run"
                "$tools/watchdog-probe" --lock sh "$tools/run-driver" run "$2" "$run"
                cat "$run/driver-bug.out" ;;
            panic) new_run panic; exec "$tools/run-panic" "$run" ;;
            deadline|backlog|tcp)
                scenario=$2; shift 2
                advanced run "$scenario" "$@" ;;
            *)
                "$tools/case-suite" --has "$2" || usage
                new_run "$2-run"
                "$tools/run-suite" run "$2" "$run"
                cat "$run/$2-bug.out" ;;
        esac
        ;;
    verify)
        [ "$#" -ge 2 ] || usage
        case "$2" in
            memory-cma) new_run memory-cma; exec "$tools/watchdog-probe" --lock sh "$tools/run-cma" verify "$run" ;;
            irq-ownership|irq-wake|irq-shared|irq-defer|irq-drain|sync-transaction|sync-trylock|sync-assert|rcu-readside|rcu-srcu|rcu-callback)
                new_run "$2-verify"
                "$tools/watchdog-probe" --lock sh "$tools/run-study" verify "$2" "$run"
                cat "$run/study-bug.out" "$run/study-fixed.out"
                "$tools/check-result" "$2" verify "$run" 0 ;;
            async-coalesce|async-ordered|async-predicate|async-reference|async-stop)
                new_run "$2-verify"
                "$tools/watchdog-probe" --lock sh "$tools/run-async" verify "$2" "$run"
                cat "$run/async-bug.out" "$run/async-fixed.out"
                "$tools/check-result" "$2" verify "$run" 0 ;;
            driver-match|driver-property|driver-defer|driver-unwind|driver-remove)
                new_run "$2-verify"
                "$tools/watchdog-probe" --lock sh "$tools/run-driver" verify "$2" "$run"
                cat "$run/driver-bug.out" "$run/driver-fixed.out"
                "$tools/check-result" "$2" verify "$run" 0 ;;
            crash)
                new_run crash-verify
                "$tools/crash-fixed" 1 > "$run/crash-valid.out"
                normal=$(cat "$run/crash-valid.out")
                [ "$normal" = 'record=1 value=64' ] || exit 1
                echo "$normal"
                result=0
                if "$tools/crash-fixed" 42 > "$run/crash-missing.out" 2> "$run/crash-missing.err"; then
                    echo '[sadboard] [ERROR] Missing record incorrectly accepted' >&2
                    exit 1
                else
                    result=$?
                    [ "$result" = 2 ] || exit "$result"
                fi
                echo "$result" > "$run/crash-missing.exit"
                cat "$run/crash-missing.err" >&2
                "$tools/check-result" crash verify "$run" 0
                echo '[sadboard] [INFO] Reference repair passed: valid input works; missing record returns 2' ;;
            oom)
                new_run oom-verify
                result=0
                "$tools/run-memory" bug "$run" || result=$?
                [ "$result" = 137 ] || exit 70
                "$tools/run-memory" fixed "$run"
                "$tools/check-result" oom verify "$run" 0
                echo '[sadboard] [INFO] Reference repair passed: cgroup OOM reproduced; fixed workload completed' ;;
            network)
                new_run network-verify
                "$tools/run-network" verify "$run"
                "$tools/check-result" network verify "$run" 0 ;;
            fd)
                new_run fd-verify
                requests=${3:-128}; delay=${4:-20}
                result=0
                "$tools/fd-bug" "$requests" "$delay" > "$run/fd-bug.out" || result=$?
                echo "$result" > "$run/fd-bug.exit"
                "$tools/fd-fixed" "$requests" "$delay" > "$run/fd-fixed.out"
                echo 0 > "$run/fd-fixed.exit"
                cat "$run/fd-bug.out" "$run/fd-fixed.out"
                "$tools/check-result" fd verify "$run" 0 "$requests" "$delay"
                echo '[sadboard] [INFO] Reference repair passed: every request releases its descriptor' ;;
            cpu|lock)
                new_run "$2-verify"
                if [ "$2" = cpu ]; then set -- "$2" "${3:-4096}" "${4:-500000}" "${5:-42}"; else set -- "$2" "${3:-20}" "${4:-50000}"; fi
                name=$1; shift
                timeout -s KILL 30 "$tools/$name-bug" "$@" > "$run/$name-bug.out"
                timeout -s KILL 30 "$tools/$name-fixed" "$@" > "$run/$name-fixed.out"
                cat "$run/$name-bug.out" "$run/$name-fixed.out"
                "$tools/check-result" "$name" verify "$run" 0 "$@"
                echo '[sadboard] [INFO] Reference business results match; compare saved timings and profiling evidence' ;;
            deadline|backlog|tcp)
                scenario=$2; shift 2
                advanced verify "$scenario" "$@" ;;
            *)
                "$tools/case-suite" --has "$2" || usage
                new_run "$2-verify"
                "$tools/run-suite" verify "$2" "$run"
                cat "$run/$2-bug.out" "$run/$2-fixed.out"
                "$tools/check-result" "$2" verify "$run" 0 ;;
        esac
        ;;
    evaluate)
        [ "$#" = 3 ] && [ "$2" = crash ] || usage
        new_run crash-evaluate
        result=0
        "$tools/student-check" "$3" "$run" || result=$?
        if [ -f "$run/candidate.elf" ]; then
            (cd "$run" && sha256sum candidate.elf) > "$run/candidate.sha256"
        fi
        exit "$result"
        ;;
    *) usage ;;
esac
