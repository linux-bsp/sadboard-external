#!/bin/sh
set -eu
tools=${SADBOARD_LIBEXEC:-/usr/libexec/sadboard}
new_run() {
    . "${0%/*}/results.sh"
    root=$(sadboard_results_root)
    sadboard_results_prepare "$root"
    run=${SADBOARD_RUN:-$(mktemp -d "$root/$1-XXXXXXXX")}
    case "$(sadboard_results_filesystem "$(cd "$run" && pwd -P)")" in
        nfs|nfs4) umask 022; chmod go+rx "$run" ;;
    esac
    echo "[sadboard] [INFO] Scenario=$1 results=$run"
}
usage() {
    echo 'Usage: sadboard {list|run CASE|verify CASE}; CASE=crash|oom|cpu|lock|fd|network|panic' >&2
    exit 64
}
case "${1:-}" in
    list)
        echo 'crash  Application exits on an unknown record; GDB/core exercise'
        echo 'oom    Memory grows until a dedicated 32 MiB cgroup kills the child'
        echo 'cpu    Repeated table lookup consumes CPU; perf exercise'
        echo 'lock   Two workers wait while a mutex covers simulated I/O'
        echo 'fd     Repeated requests leak descriptors under a process-only limit of 64'
        echo 'network Isolated veth delay; ping, iperf3, tcpdump and tc exercise'
        echo 'panic  Deliberate kernel panic and reboot; check persistent evidence afterwards'
        ;;
    run)
        [ "$#" -ge 2 ] || usage
        case "$2" in
            crash)
                new_run crash
                cd "$run"
                # BusyBox ash uses 512-byte blocks for RLIMIT_CORE: 32 MiB.
                ulimit -c 65536
                result=0
                "$tools/crash-bug" "${3:-42}" > "$run/crash-bug.out" || result=$?
                cat "$run/crash-bug.out"
                exit "$result" ;;
            oom) new_run oom; exec "$tools/run-memory" bug "$run" ;;
            cpu) new_run cpu; timeout -s KILL 30 "$tools/cpu-bug" "${3:-4096}" "${4:-500000}" "${5:-42}" > "$run/cpu-bug.out"; cat "$run/cpu-bug.out" ;;
            lock) new_run lock; timeout -s KILL 20 "$tools/lock-bug" "${3:-20}" "${4:-50000}" > "$run/lock-bug.out"; cat "$run/lock-bug.out" ;;
            fd)
                new_run fd
                result=0
                "$tools/fd-bug" "${3:-128}" "${4:-20}" > "$run/fd-bug.out" || result=$?
                echo "$result" > "$run/fd-bug.exit"
                cat "$run/fd-bug.out"
                exit "$result" ;;
            network) new_run network; exec "$tools/run-network" bug "$run" ;;
            panic) new_run panic; exec "$tools/run-panic" "$run" ;;
            *) usage ;;
        esac
        ;;
    verify)
        [ "$#" -ge 2 ] || usage
        case "$2" in
            crash)
                new_run crash-verify
                "$tools/crash-fixed" 1 > "$run/crash-valid.out"
                normal=$(cat "$run/crash-valid.out")
                [ "$normal" = 'record=1 value=64' ] || exit 1
                echo "$normal"
                result=0
                if "$tools/crash-fixed" 42 > "$run/crash-missing.out" 2> "$run/crash-missing.err"; then
                    echo '[sadboard] [ERROR] Missing record incorrectly accepted' >&2
                    exit 1
                else
                    result=$?
                    [ "$result" = 2 ] || exit "$result"
                fi
                echo "$result" > "$run/crash-missing.exit"
                cat "$run/crash-missing.err" >&2
                "$tools/check-result" crash verify "$run" 0
                echo '[sadboard] [INFO] Reference repair passed: valid input works; missing record returns 2' ;;
            oom)
                new_run oom-verify
                result=0
                "$tools/run-memory" bug "$run" || result=$?
                [ "$result" = 137 ] || exit 70
                "$tools/run-memory" fixed "$run"
                "$tools/check-result" oom verify "$run" 0
                echo '[sadboard] [INFO] Reference repair passed: cgroup OOM reproduced; fixed workload completed' ;;
            network)
                new_run network-verify
                "$tools/run-network" verify "$run"
                "$tools/check-result" network verify "$run" 0 ;;
            fd)
                new_run fd-verify
                requests=${3:-128}; delay=${4:-20}
                result=0
                "$tools/fd-bug" "$requests" "$delay" > "$run/fd-bug.out" || result=$?
                echo "$result" > "$run/fd-bug.exit"
                "$tools/fd-fixed" "$requests" "$delay" > "$run/fd-fixed.out"
                echo 0 > "$run/fd-fixed.exit"
                cat "$run/fd-bug.out" "$run/fd-fixed.out"
                "$tools/check-result" fd verify "$run" 0 "$requests" "$delay"
                echo '[sadboard] [INFO] Reference repair passed: every request releases its descriptor' ;;
            cpu|lock)
                new_run "$2-verify"
                if [ "$2" = cpu ]; then set -- "$2" "${3:-4096}" "${4:-500000}" "${5:-42}"; else set -- "$2" "${3:-20}" "${4:-50000}"; fi
                name=$1; shift
                timeout -s KILL 30 "$tools/$name-bug" "$@" > "$run/$name-bug.out"
                timeout -s KILL 30 "$tools/$name-fixed" "$@" > "$run/$name-fixed.out"
                cat "$run/$name-bug.out" "$run/$name-fixed.out"
                "$tools/check-result" "$name" verify "$run" 0 "$@"
                echo '[sadboard] [INFO] Reference business results match; compare saved timings and profiling evidence' ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
