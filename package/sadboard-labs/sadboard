#!/bin/sh
# Public lifecycle entry; experiment payloads live in execute.
set -eu
umask 077
tools=${SADBOARD_LIBEXEC:-/usr/libexec/sadboard}
usage() {
    echo 'Usage: sadboard list [ID_PREFIX] | results | {run|verify} CASE [NUMERIC_ARGS] | evaluate crash /ABSOLUTE/PROGRAM | {status|check|reset|share} RUN_DIRECTORY' >&2
    echo 'List prefixes: B-CR B-FD B-MM B-CPU B-SYNC B-NET B-BOOT A-P A-M A-N L-ASM K- K-DRV' >&2
    echo 'CASE: crash [KEY], oom, cpu [ITEMS QUERIES SEED], lock [ITERATIONS DELAY_US], fd [REQUESTS DELAY_MS], network, panic (run only)' >&2
    echo 'Advanced: deadline [CYCLES PERIOD_US WORK_US], backlog [MESSAGES PAYLOAD_KIB], tcp [RECORDS]' >&2
    exit 64
}
error() { echo "[sadboard] [ERROR] $*" >&2; exit 75; }
read_field() { sed -n "s/^$1=//p" "$2"; }
load_results() {
    . "$tools/results.sh"
    root=$(sadboard_results_root) || error 'Cannot select result directory'
}
case "${1:-}" in
    list) [ "$#" -le 2 ] || usage; exec sh "$tools/execute" "$@" ;;
    results)
        [ "$#" = 1 ] || usage
        load_results
        sadboard_results_prepare "$root" || error 'Cannot prepare result directory'
        cd "$root" && pwd -P
        ;;
    run|verify|evaluate)
        [ "$#" -ge 2 ] || usage
        operation=$1; scenario=$2
        if [ "$operation" = evaluate ]; then
            [ "$#" = 3 ] && [ "$scenario" = crash ] || usage
            case "$3" in /*) ;; *) usage ;; esac
            [ -f "$3" ] && [ -x "$3" ] && [ ! -L "$3" ] || error 'Use a regular executable candidate'
        else
        case "$scenario:$#" in
            crash:2|oom:2|cpu:2|lock:2|fd:2|network:2|deadline:2|backlog:2|tcp:2) ;;
            panic:2|kernel-oops:2|kernel-lockup:2|watchdog-probe:2) [ "$operation" = run ] || usage ;;
            crash:3) [ "$operation" = run ] || usage ;;
            cpu:5|lock:4|fd:4|deadline:5|backlog:4|tcp:3) ;;
            driver-match:2|driver-property:2|driver-defer:2|driver-unwind:2|driver-remove:2) ;;
            *)
                [ "$#" = 2 ] && [ -x "$tools/case-suite" ] && "$tools/case-suite" --has "$scenario" || usage ;;
        esac
        fi
        shift 2
        if [ "$#" = 0 ]; then
            case "$scenario:$operation" in
                crash:run) set -- 42 ;;
                cpu:*) set -- 4096 500000 42 ;;
                lock:*) set -- 20 50000 ;;
                fd:*) set -- 128 20 ;;
                deadline:*) set -- 200 10000 2000 ;;
                backlog:*) set -- 512 64 ;;
                tcp:*) set -- 8192 ;;
            esac
        fi
        if [ "$operation" != evaluate ]; then
        for value in "$@"; do
            case "$value" in ''|*[!0-9]*|????????????*) usage ;; esac
        done
        fi
        # Panic exercises an unsealed startup of a previously confirmed image.
        # The FWOTA2 checks below still reject trial/pending firmware.
        case "$scenario" in panic|kernel-oops|kernel-lockup|watchdog-probe) ;; *)
            [ -f /run/fwctl-boot-confirmed ] || error 'Wait for local boot health confirmation'
        esac
        load_results
        sadboard_results_prepare "$root" || error 'Cannot prepare result directory'
        root=$(cd "$root" && pwd -P)
        filesystem=$(sadboard_results_filesystem "$root") || error 'Cannot determine result filesystem'
        run_umask=0077
        case "$filesystem" in
            nfs|nfs4) run_umask=0022; umask 022 ;;
            *) [ "$(cat /run/device-manager/storage-state)" = persistent ] || error 'Persistent data storage is unavailable' ;;
        esac
        available=$(df -Pk "$root" | { read -r header; read -r source blocks used free rest; echo "$free"; })
        case "$available" in ''|*[!0-9]*) error 'Cannot read free data space' ;; esac
        [ "$available" -ge 65536 ] || error 'Result filesystem needs at least 64 MiB free; archive old evidence first'
        # Public machine interface; do not parse a private fwctld journal.
        status=$(timeout -s KILL 10 "${BSP_LIBEXEC:-/usr/libexec/bsp}/boot-context") || error 'Cannot read boot context'
        read -r format booted active pending v0 g0 s0 id0 v1 g1 s1 id1 extra <<EOF
$status
EOF
        boot_mode=local-ab
        if [ "$format" = BSPNET1 ]; then
            boot_mode=network-debug
            read -r format version firmware extra <<EOF
$status
EOF
            [ -z "$extra" ] && [ "${#firmware}" = 64 ] || error 'Invalid network build information'
            case "$version" in ''|*[!0-9]*|??????????*) error 'Invalid network build version' ;; esac
            case "$scenario" in panic|kernel-oops|kernel-lockup|watchdog-probe)
                [ "$(cat /data/bsp/netboot-confirmed 2>/dev/null)" = "$firmware" ] || error 'First complete a healthy network boot of this build'
            ;; esac
        else
        [ "$format" = FWOTA2 ] && [ -z "$extra" ] && [ "$pending" = 255 ] || error 'Firmware update is pending or status format is invalid'
        case "$booted" in
            0) version=$v0; good=$g0; state=$s0; firmware=$id0 ;;
            1) version=$v1; good=$g1; state=$s1; firmware=$id1 ;;
            *) error 'Unknown booted deployment' ;;
        esac
        [ "$good:$state" = 1:4 ] && [ "${#firmware}" = 64 ] || error 'Running firmware is not confirmed'
        fi
        case "$firmware" in *[!0-9a-f]*) error 'Invalid firmware content ID' ;; esac
        run=$(mktemp -d "$root/$scenario-$(date +%Y%m%dT%H%M%S)-XXXXXXXX")
        case "$filesystem" in nfs|nfs4) chmod go+rx "$run" ;; esac
        unit=sadboard-${run##*/}.service
        tag=v$((version >> 16)).$(((version >> 8) & 255)).$((version & 255))
        {
            echo 'format=SADBOARD1'
            echo "case=$scenario"
            echo "operation=$operation"
            echo "unit=$unit"
            echo "started=$(date '+%Y-%m-%dT%H:%M:%S%z')"
            echo "boot_id=$(cat /proc/sys/kernel/random/boot_id)"
            echo "boot_mode=$boot_mode"
            echo "results_filesystem=$filesystem"
            echo "firmware_tag=$tag"
            echo "firmware_id=$firmware"
            echo "kernel=$(uname -r)"
            echo "command=$tools/execute $operation $scenario"
            if [ "$operation" = evaluate ]; then
                echo "candidate_source=$1"
            else
                for value in "$@"; do echo "argument=$value"; done
            fi
            [ "$scenario" != oom ] || echo 'memory_budget=33554432; chunks=64; delay_ms=50'
        } > "$run/run.info"
        printf '%s\n' "$status" > "$run/firmware-status.txt"
        short=$(printf '%.8s' "$firmware")
        echo "[sadboard] [INFO] results=$run firmware=$tag/$short"
        cancelled=0
        stop_run() { cancelled=1; systemctl stop "$unit" 2>/dev/null || true; }
        trap stop_run INT TERM HUP
        result=0
        task_limit=16
        [ "$scenario" != memory-threads ] || task_limit=24
        run_limit=30s
        case "$scenario" in memory-cma) run_limit=100s ;; kernel-oops|kernel-lockup|watchdog-probe) run_limit=150s ;; esac
        systemd-run --quiet --wait --collect --service-type=exec --unit="$unit" \
            --property="RuntimeMaxSec=$run_limit" --property=TimeoutStopSec=5s \
            --property=KillMode=control-group --property=MemoryMax=134217728 \
            --property="TasksMax=$task_limit" --property=CPUAccounting=yes --property=CPUWeight=100 --property=LimitCORE=33554432 \
            --property="UMask=$run_umask" \
            --property="WorkingDirectory=$run" \
            --property="StandardOutput=append:$run/stdout.log" \
            --property="StandardError=append:$run/stderr.log" \
            --setenv="SADBOARD_RUN=$run" --setenv="SADBOARD_LIBEXEC=$tools" \
            --setenv="SADBOARD_DRIVER_MODULE=${SADBOARD_DRIVER_MODULE:-}" \
            sh "$tools/execute" "$operation" "$scenario" "$@" \
            > "$run/supervisor.log" 2>&1 || result=$?
        trap - INT TERM HUP
        supervisor_result=$result
        [ ! -f "$run/cancel.request" ] || cancelled=1
        [ "$cancelled" = 0 ] || result=130
        {
            echo "exit_code=$result"
            echo "supervisor_exit_code=$supervisor_result"
            echo "cancelled=$cancelled"
            echo "finished=$(date '+%Y-%m-%dT%H:%M:%S%z')"
        } > "$run/result.new"
        mv "$run/result.new" "$run/result"
        sadboard_results_share "$run" || error "Cannot make evidence host-readable (experiment exit=$result)"
        for log in "$run/stdout.log" "$run/stderr.log"; do
            if [ -f "$log" ]; then cat "$log"; fi
        done
        echo "[sadboard] [INFO] exit=$result evidence=$run"
        exit "$result"
        ;;
    status|check|reset|share)
        [ "$#" = 2 ] || usage
        operation=$1
        load_results
        root=$(cd "$root" && pwd -P)
        [ ! -L "$2" ] && [ -d "$2" ] || error 'Use an existing experiment directory'
        run=$(cd "$2" && pwd -P)
        [ "${run%/*}" = "$root" ] || error 'Directory is outside the result root'
        if [ "$operation" = share ]; then
            sadboard_results_share "$run" || error 'Cannot make evidence host-readable'
            echo "[sadboard] [INFO] Evidence ready for host access: $run"
            exit 0
        fi
        [ -f "$run/run.info" ] || error 'Directory is not a managed experiment'
        [ "$(read_field format "$run/run.info")" = SADBOARD1 ] || error 'Unknown experiment format'
        unit=sadboard-${run##*/}.service
        [ "$(read_field unit "$run/run.info")" = "$unit" ] || error 'Experiment unit mismatch'
        case "${run##*/}" in *[!A-Za-z0-9_-]*) error 'Invalid experiment name' ;; esac
        if [ "$operation" = reset ]; then
            if [ "$(read_field boot_id "$run/run.info")" = "$(cat /proc/sys/kernel/random/boot_id)" ]; then
                if systemctl is-active --quiet "$unit"; then
                    : > "$run/cancel.request"
                    systemctl stop "$unit"
                fi
                if [ "$(read_field case "$run/run.info")" = network ]; then
                    ip netns del "sb-left-${run##*/}" 2>/dev/null || true
                    ip netns del "sb-right-${run##*/}" 2>/dev/null || true
                fi
                if [ -x "$tools/case-suite" ] && "$tools/case-suite" --has "$(read_field case "$run/run.info")"; then
                    ip netns del "sb-suite-${run##*/}" 2>/dev/null || true
                    ip netns del "sb-sl-${run##*/}" 2>/dev/null || true
                    ip netns del "sb-sr-${run##*/}" 2>/dev/null || true
                    ip netns del "sb-sw-${run##*/}" 2>/dev/null || true
                    "$tools/cleanup-cgroups" "$run"
                fi
                if [ "$(read_field case "$run/run.info")" = memory-cma ] && [ -w /sys/kernel/debug/sadboard-faults/control ]; then
                    "$tools/watchdog-probe" --lock sh -c 'echo release > /sys/kernel/debug/sadboard-faults/control'
                fi
                case "$(read_field case "$run/run.info")" in
                    driver-match|driver-property|driver-defer|driver-unwind|driver-remove)
                        "$tools/watchdog-probe" --lock sh "$tools/run-driver" reset "$(read_field case "$run/run.info")" "$run" ;;
                esac
                if [ "$(read_field case "$run/run.info")" = tcp ]; then
                    ip netns del "sb-tcp-${run##*/}" 2>/dev/null || true
                fi
            fi
            echo '[sadboard] [INFO] Experiment stopped; evidence retained'
            exit 0
        fi
        cat "$run/run.info"
        if [ "$operation" = check ]; then
            case "$(read_field case "$run/run.info")" in kernel-oops|kernel-lockup|watchdog-probe) exec "$tools/check-kernel" "$run" ;; esac
        fi
        if [ "$operation" = check ] && [ "$(read_field case "$run/run.info")" = panic ]; then
            exec "$tools/check-panic" "$run"
        fi
        if [ "$operation" = status ] && [ -f "$run/recovery.result" ]; then
            cat "$run/recovery.result"
            echo 'result=recovery-verified'
            exit 0
        fi
        [ -f "$run/result" ] || { echo 'result=incomplete (running or interrupted)'; exit 1; }
        cat "$run/result"
        [ "$operation" = check ] || exit 0
        code=$(read_field exit_code "$run/result")
        [ "$(read_field cancelled "$run/result")" = 0 ] || exit 1
        op=$(read_field operation "$run/run.info")
        scenario=$(read_field case "$run/run.info")
        set --
        while IFS= read -r line; do
            case "$line" in
                argument=*)
                    value=${line#argument=}
                    case "$value" in ''|*[!0-9]*|????????????*) error 'Invalid recorded parameter' ;; esac
                    set -- "$@" "$value" ;;
            esac
        done < "$run/run.info"
        if [ "$op" = evaluate ]; then
            expected_hash=$(cat "$run/candidate.sha256")
            actual_hash=$(cd "$run" && sha256sum candidate.elf)
            [ "$expected_hash" = "$actual_hash" ] || error 'Candidate snapshot hash differs'
        fi
        exec "$tools/check-result" "$scenario" "$op" "$run" "$code" "$@"
        ;;
    *) usage ;;
esac
