BR2_TARGET_GENERIC_HOSTNAME="sadboard-am625"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SADBOARD_PATH)/kernel/debug.config"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LINUX_BSP_PATH)/board/ti/am625/rootfs-overlay $(BR2_EXTERNAL_SADBOARD_PATH)/rootfs-overlay"
# Reuse the board's existing bootloader; produce kernel and NFS rootfs only.
# BR2_TARGET_UBOOT is not set
# BR2_TARGET_TI_K3_R5_LOADER is not set
# BR2_TARGET_ARM_TRUSTED_FIRMWARE is not set
# BR2_TARGET_OPTEE_OS is not set
BR2_TARGET_TI_K3_BOOT_FIRMWARE=y
BR2_ROOTFS_POST_IMAGE_SCRIPT=""
BR2_ROOTFS_POST_IMAGE_SCRIPT_ARGS=""
