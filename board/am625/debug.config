BR2_TARGET_GENERIC_HOSTNAME="sadboard-am625"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SADBOARD_PATH)/board/am625/uboot-netboot.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SADBOARD_PATH)/kernel/debug.config"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LINUX_BSP_PATH)/board/ti/am625/rootfs-overlay $(BR2_EXTERNAL_SADBOARD_PATH)/rootfs-overlay"
# Keep local verified A/B boot available; network boot uses its own health gate.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_LINUX_BSP_PATH)/board/ti/am625/post-build-ti.sh $(BR2_EXTERNAL_SADBOARD_PATH)/scripts/netboot-build.py"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_LINUX_BSP_PATH)/support/scripts/firmware-image.sh $(BR2_EXTERNAL_SADBOARD_PATH)/scripts/export-debug.py"
BR2_PACKAGE_EDK_BUILD_TYPE_RELWITHDEBINFO=y
BR2_PACKAGE_SADBOARD_LABS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SADBOARD_PATH)/board/am625/busybox-debug.config"
